{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "100%",
			"wideSize": "100%"
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"presicav\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
					"name": "Presicav",
					"slug": "presicav"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|presicav",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|presicav",
					"fontWeight": "400"
				}
			}
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
